<% layout("/layouts/boilerplate.ejs") %>
<body>
    <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <h2>Sign up on Wanderlust</h2>
        <form method="POST" action="/signup" novalidate class="needs-validation">
            <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" required autocomplete="off" class="form-control">
            <div class="invalid-feedback">Required</div>
            </div>
            <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" name="username" required autocomplete="off" class="form-control">
            <div class="invalid-feedback">Required</div>
            </div>
            <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" required autocomplete="off" class="form-control">
            <div class="invalid-feedback">Required</div>
            </div>
            <button class="btn btn-success">Sign up</button>
        </form>
        <p class="mt-2">Already registered? <a href="/login"> Log in</a></p>
    </div>
    </div>
</body>
