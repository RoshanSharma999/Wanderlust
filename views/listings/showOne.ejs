<% layout("/layouts/boilerplate.ejs") %>
<body id="showOne">
    <h2><%= thisListing.title %></h2>
    <div class="details">
        <div class="img-cont">
            <img src="<%= thisListing.image.url %>" width="500px">
            <p class="mt-1"> Owned by: <%= thisListing.owner.username %></p>
        </div>
        <div>
            <ul>
                <li>Description: <%= thisListing.desc %></li>
                <li>Price: &#8377;<%= thisListing.price.toLocaleString("en-IN") %> per day</li>
                <li>Location: <%= thisListing.location %></li>
                <li>Country: <%= thisListing.country %></li>
            </ul>
            <% if(currUser && currUser._id.equals(thisListing.owner._id)){ %>
            <form method="GET" action="/listings/<%= thisListing._id %>/edit"><button class="btn btn-danger">Edit</button></form>
            <form method="POST" action="/listings/<%= thisListing._id %>?_method=DELETE" class="show-loader">
                <button class="btn btn-dark">Delete</button></form>
            <% } %>
            <% if(currUser){ %>
            <hr>
            <div>
                <h5>Leave a Review</h5>
                <form method="POST" action="/listings/<%= thisListing._id %>/reviews" novalidate class="needs-validation">
                    <!-- <input class="form-range" type="range" min="1" max="5" name="review[rating]" id="rating"> -->
                    <div>
                        <div class="rev-label-rating">
                        <label class="mt-2 mr-6">Rating</label>
                        <fieldset class="starability-grow">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating" />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="comment">Comment</label>
                        <textarea name="review[comment]" id="comment" cols="30" class="form-control" required></textarea>
                        <div class="invalid-feedback">Please add some comment</div>
                    </div>
                    <button class="btn btn-outline-dark mt-2 mb-3">Submit</button>
                </form>
            </div>
            <% } %>
        </div>
    </div>
    <hr>
    <h4>All Reviews</h4>
    <% if(thisListing.reviews.length == 0){ %>
        <p>No reviews yet</p>
    <% }else{ %>
    <div class="review-container">
        <% for(review of thisListing.reviews){ %>
            <div class="card">
            <div class="card-body rev-card">
                <div class="rev-rating-username">
                    <h6>@<%= review.author.username %></h6>
                    <p class="starability-result" data-rating="<%= review.rating %>"></p> 
                </div>
                <p> <%= review.comment %> </p>
                <% if(currUser && review.author._id.equals(currUser._id)){ %>
                <form method="POST" action="/listings/<%= thisListing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="btn btn-sm btn-outline-dark">Delete</button>
                </form>
                <% } %>
            </div>
            </div>
        <% } %>
    </div>
    <% } %>
</body>
